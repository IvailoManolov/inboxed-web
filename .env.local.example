# Inboxed web — environment. Copy to `.env.local` and fill in.
# NEXT_PUBLIC_* values are exposed to the browser (safe). The rest are
# SERVER-ONLY secrets — never prefix them with NEXT_PUBLIC.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRICE_LABEL=$9/mo

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# --- Stripe (test mode: Developers → API keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
# The recurring Price you create for the Pro plan (Products → your product → Pricing).
STRIPE_PRICE_ID=price_xxx
